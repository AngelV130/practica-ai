# Aplicacion
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
TRUST_PROXY=false
LOG_LEVEL=info
ERROR_LOG_ENABLED=true
ERROR_LOG_PATH=logs/error.log

# CORS: lista separada por comas. Vacio permite cualquier origen fuera de produccion.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Limites
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

# Resumenes con IA mediante OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=http://url.com
OPENROUTER_MODEL=nombre-del-modelo
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=500

# HTTPS/TLS. En produccion configura rutas absolutas montadas como secretos.
TLS_ENABLED=false
TLS_KEY_PATH=/run/secrets/tls.key
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_CA_PATH=
TLS_PASSPHRASE=
